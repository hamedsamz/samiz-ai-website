# Set per deployment. Keep disabled until the isolated database, email and storage are ready.
ACADEMY_ENABLED=false
NEXT_PUBLIC_ACADEMY_ENABLED=false
ACADEMY_ORIGIN=
ACADEMY_DATABASE_URL=
ACADEMY_AUTH_SECRET=

# Reuse the existing verified Resend sender. Scope actual values to the environment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Set the ID only after the owner has verified their email. The base32 key is server-only.
ACADEMY_ADMIN_USER_ID=
ACADEMY_ADMIN_TOTP_SECRET=

# Credentials for private Cloudflare R2. Use a bucket-scoped Object Read Only token.
ACADEMY_R2_ACCOUNT_ID=
ACADEMY_R2_BUCKET=
ACADEMY_R2_ACCESS_KEY_ID=
ACADEMY_R2_SECRET_ACCESS_KEY=
